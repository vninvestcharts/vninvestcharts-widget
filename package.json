{
  "name": "@vninvestcharts/widget",
  "version": "0.4.1",
  "description": "Professional-grade Vietnamese stock charting library with real-time VN market data, 59 indicators, 76 drawing tools, and embeddable React widget",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/dts/public-api.d.ts",
  "sideEffects": true,
  "engines": {
    "node": ">=18.18"
  },
  "packageManager": "npm@10.9.2",
  "files": [
    "dist/",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/dts/public-api.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters/index.d.ts",
      "import": "./dist/adapters/index.js",
      "require": "./dist/adapters/index.cjs"
    },
    "./drawing": {
      "types": "./dist/drawing/index.d.ts",
      "import": "./dist/drawing/index.js",
      "require": "./dist/drawing/index.cjs"
    },
    "./types": {
      "types": "./dist/types/runtime.d.ts",
      "import": "./dist/types/runtime.js",
      "require": "./dist/types/runtime.cjs"
    },
    "./iframe": "./dist/iframe/vninvestchart.iframe.js",
    "./iframe-host": {
      "types": "./dist/iframe-host/host-entry.d.ts",
      "import": "./dist/iframe-host/host-entry.js",
      "require": "./dist/iframe-host/host-entry.cjs"
    },
    "./dist/index.css": "./dist/index.css"
  },
  "author": {
    "name": "Phạm Việt Dũng",
    "email": "vietdung@edusuccess.vn"
  },
  "homepage": "https://saas.edusuccess.vn",
  "license": "Apache-2.0",
  "publishConfig": {
    "tag": "latest",
    "access": "public"
  },
  "scripts": {
    "clean": "rimraf -rf ./build ./dist",
    "build": "node build-all.js",
    "build:tsup": "tsup",
    "build:widget:umd": "cross-env BUILD_TARGET=umd vite build",
    "build:widget:esm": "cross-env BUILD_TARGET=esm vite build",
    "build:widget": "npm run build:widget:umd && npm run build:widget:esm",
    "build:iife": "npx tsup --config tsup.config.ts",
    "storybook": "storybook dev -p 6006",
    "build:storybook": "storybook build",
    "watch": "npm run clean && npm run build:css && npm run copy:monaco && cross-env IP=0.0.0.0 PORT=3000 webpack serve --config config/webpack.config.js",
    "build:docs": "cross-env NODE_ENV=production webpack --mode production --config config/webpack.config.js && npm run copy:monaco && node scripts/generate-health.js && node scripts/check-bundle-mode.cjs --dir build --dir dist",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx src",
    "lint:fix": "eslint --ext .js,.jsx,.ts,.tsx src --fix",
    "lint:ratchet": "node scripts/lint-ratchet.js",
    "lint:ratchet:update": "node scripts/lint-ratchet.js --update",
    "audit:fat-files": "node scripts/check-fat-files.js",
    "audit:dom-access": "node scripts/check-dom-access.cjs",
    "audit:dom-access:self-test": "node scripts/check-dom-access.cjs --self-test",
    "audit:props": "node scripts/check-props-count.js",
    "audit:any": "node scripts/check-any-count.js",
    "audit:drawing-boundary": "node scripts/check-drawing-import-boundary.js",
    "check:build-entries": "node scripts/check-build-entries.cjs",
    "check:build-entries:self-test": "node scripts/check-build-entries.cjs --self-test",
    "check:staging": "node scripts/check-staging.cjs",
    "check:staging:self-test": "node scripts/check-staging.cjs --self-test",
    "check:e2e-license": "node scripts/e2e-license.cjs --self-test",
    "check:runbook-commands": "node scripts/check-runbook-commands.cjs",
    "check:runbook-commands:self-test": "node scripts/check-runbook-commands.cjs --self-test",
    "check:lessons": "node scripts/check-lessons.cjs",
    "check:agent-config": "node scripts/check-agent-config.cjs",
    "gate:slice": "node scripts/gate-slice.cjs",
    "gate:slice:self-test": "node scripts/gate-slice.cjs --self-test",
    "attest:plan": "node scripts/attest-plan.cjs",
    "attest:plan:check": "node scripts/attest-plan.cjs --check",
    "attest:plan:self-test": "node scripts/attest-plan.cjs --self-test",
    "verify:agent-plugin": "node scripts/verify-agent-plugin.cjs",
    "verify:agent-log": "node scripts/verify-agent-log.cjs",
    "slice:new": "node scripts/new-slice.cjs",
    "ledger:append": "node scripts/ledger.cjs",
    "check:lessons:self-test": "node scripts/check-lessons.cjs --self-test",
    "gen:engine-paths": "node scripts/gen-engine-tsconfig-paths.mjs",
    "gen:pine-parser": "tsx scripts/gen-pine-parser.ts",
    "copy:monaco": "node scripts/copy-monaco.mjs",
    "pretype-check": "npm run gen:engine-paths && npm run gen:pine-parser",
    "pretest": "npm run gen:engine-paths && npm run build:css && npm run gen:pine-parser",
    "prewatch": "npm run gen:pine-parser",
    "prebuild:docs": "npm run gen:pine-parser",
    "prebuild:iife": "npm run gen:pine-parser",
    "build:css": "node build-css-modules-v2.js",
    "prebuild": "npm run gen:engine-paths && npm run gen:pine-parser",
    "check-engine-timestamp": "node scripts/check-engine-timestamp.js",
    "verify-dist": "node scripts/verify-dist.js",
    "check:rollback-readiness": "node scripts/check-rollback-readiness.mjs",
    "verify:consumer": "node scripts/consumer-smoke.mjs",
    "sync:version": "node scripts/sync-version.js",
    "check:version": "node scripts/sync-version.js --check",
    "check:semver": "node scripts/check-semver-breaking.mjs",
    "release:manifest": "node scripts/generate-release-manifest.js",
    "release:guard": "node scripts/generate-release-manifest.js --check",
    "release:publish-next": "npm run release:guard && npm publish --tag next",
    "check:release-manifest": "node scripts/generate-release-manifest.js --check",
    "verify:undo": "node scripts/stability-undo.cjs",
    "verify:p3": "node scripts/verify-p3.cjs",
    "verify:export": "node scripts/verify-export.cjs",
    "verify:capability-gate": "node scripts/verify-capability-gate.cjs",
    "verify:alerts": "node scripts/verify-alerts.cjs",
    "verify:degraded-data": "node scripts/verify-degraded-data.cjs",
    "verify:mobile": "node scripts/verify-mobile-runtime.cjs",
    "verify:ui-sweep": "node scripts/verify-ui-text-sweep.cjs",
    "verify:ux05": "node scripts/verify-ux05-recovery.cjs",
    "verify:ux05-states": "node scripts/verify-ux05-empty-loading.cjs",
    "verify:license-persist": "node scripts/verify-license-persist.cjs",
    "verify:offline-license": "node scripts/verify-offline-license.cjs",
    "verify:demo-mode": "node scripts/verify-demo-mode.cjs",
    "verify:uiux-controls": "node scripts/verify-uiux-controls.cjs",
    "verify:uiux-controls:selftest": "node scripts/verify-uiux-controls.selftest.cjs",
    "rebuild:engine": "cd ../vninvestcharts-engine && npm run build",
    "audit:hardcoded-text": "node scripts/audit-hardcoded-text.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:widget-contract": "node scripts/runWidgetContractTests.js",
    "test:widget-contract:ci": "node scripts/runWidgetContractTests.js --ci",
    "test:soak": "vitest run tests/soak",
    "benchmark:backfill": "vitest run tests/soak/backfill_benchmark.test.ts",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:ci": "playwright test --reporter=github",
    "test:integration": "vitest run src/widget/__tests__/VNInvestCharts.integration.test.tsx",
    "test:integration:watch": "vitest src/widget/__tests__/VNInvestCharts.integration.test.tsx",
    "build:npm": "node build-all.js",
    "prepublishOnly": "cross-env NPM_PUBLISH=1 node build-all.js",
    "build:analyze": "tsup --config tsup.config.ts --analyze",
    "bundlesize": "node scripts/check-bundle-size.js",
    "bundlesize:ratchet": "node scripts/bundle-ratchet.js",
    "bundlesize:ratchet:update": "node scripts/bundle-ratchet.js --update",
    "generate:module-tree": "npx tsx scripts/generate-module-graph.ts",
    "verify:magnet": "node scripts/verify-magnet.cjs",
    "verify:shadow-tokens": "node scripts/verify-shadow-tokens.cjs",
    "audit:package-side-effects": "node scripts/check-package-side-effects.js --allow-missing-engine",
    "audit:paid-capability": "node scripts/check-paid-capability-enforcement.js",
    "audit:capability-copy": "node scripts/check-capability-copy-claims.mjs",
    "audit:capability-copy:self-test": "node scripts/check-capability-copy-claims.mjs --self-test",
    "audit:paid-capability:self-test": "node scripts/check-paid-capability-enforcement.js --self-test",
    "audit:script-existence": "node scripts/check-script-existence.mjs",
    "audit:scope-spelling": "node scripts/check-scope-spelling.js",
    "audit:local-ident-name": "node scripts/check-local-ident-name.cjs",
    "audit:unused-exports": "node scripts/find-unused-exports.js",
    "audit:license": "node scripts/check-license.mjs",
    "audit:readme-claims": "node scripts/check-readme-claims.mjs",
    "sync:engine-dist": "node scripts/sync-engine-dist.js",
    "check:engine-dist": "node scripts/sync-engine-dist.js --check"
  },
  "dependencies": {
    "@vninvestcharts/engine-core": "^0.4.0",
    "@vninvestcharts/engine-drawing": "^0.4.0",
    "@vninvestcharts/engine-react": "^0.4.0",
    "d3-array": "^3.2.0",
    "d3-force": "^3.0.0",
    "d3-format": "^3.1.0",
    "d3-interpolate": "^3.0.1",
    "d3-path": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-scale-chromatic": "^3.1.0",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-time": "^3.1.0",
    "d3-time-format": "^4.1.0",
    "lodash.flattendeep": "^4.4.0",
    "prop-types": "^15.8.1",
    "save-svg-as-png": "^1.4.17"
  },
  "peerDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "monaco-editor": "^0.55.1",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.0",
    "@babel/preset-env": "^7.23.0",
    "@babel/preset-react": "^7.22.15",
    "@babel/preset-typescript": "^7.23.0",
    "@playwright/test": "^1.60.0",
    "@storybook/react-vite": "^10.3.6",
    "@storybook/test-runner": "^0.24.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.1.8",
    "@types/pngjs": "^6.0.5",
    "@types/prop-types": "^15.7.15",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.61.0",
    "@typescript-eslint/parser": "^8.61.0",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/coverage-v8": "^1.6.1",
    "babel-loader": "^9.2.1",
    "babel-plugin-transform-flow-strip-types": "^6.22.0",
    "cross-env": "^7.0.3",
    "css-loader": "^6.8.1",
    "esbuild-plugin-css-modules": "^0.3.0",
    "eslint": "^8.51.0",
    "eslint-plugin-const-immutable": "^2.1.0",
    "eslint-plugin-flowtype": "^8.0.3",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "html-webpack-plugin": "^5.5.3",
    "jsdom": "^29.1.1",
    "msw": "^2.14.6",
    "peggy": "^5.1.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rimraf": "^5.0.5",
    "storybook": "^10.3.6",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.5.0",
    "ts-morph": "^28.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.10",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^1.6.1",
    "webpack": "^5.88.2",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^4.15.1"
  }
}
